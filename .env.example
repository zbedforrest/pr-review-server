# ============================================
# PR Review Server Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ============================================
# Required Configuration
# ============================================

# GitHub personal access token (classic) with 'repo' and 'read:org' scopes
# Get one at: https://github.com/settings/tokens
# - 'repo' scope: Access PR data, reviews, and commits
# - 'read:org' scope: Read team memberships for review requests
# Note: Classic tokens recommended (fine-grained tokens may have limitations)
GITHUB_TOKEN=your_github_token_here

# Your GitHub username
GITHUB_USERNAME=your_github_username

# ============================================
# Optional Configuration (AI Reviews)
# ============================================

# Gemini API key for AI review generation
# Get one at: https://aistudio.google.com/app/apikey
# Only needed if you want automated AI reviews
#GEMINI_API_KEY=your_gemini_key_here

# Override the Gemini model ids without a rebuild
# Defaults: gemini-flash-latest / gemini-3.1-pro-preview
#GEMINI_FLASH_MODEL=gemini-flash-latest
#GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# ============================================
# Optional Configuration (Server)
# ============================================

# How often to poll GitHub for PR updates
# Examples: 30s, 1m, 5m, 1h
# Default: 1m
#POLLING_INTERVAL=1m

# Port for the web dashboard
# Default: 8080
#SERVER_PORT=8080

# Enable development mode (auto-login based on GITHUB_USERNAME)
# Default: false (true if no OAuth configured)
#DEV_MODE=false

# Skip the initial and scheduled GitHub polls entirely. Useful when running
# the server purely as an on-demand review API (e.g. benchmarks).
# Default: false
#DISABLE_POLLING=true

# SQLite database file path (ignored when DATABASE_URL is set)
# Default: ./data/pr-review.db
#DB_PATH=./data/pr-review.db

# Skip GORM auto-migration at boot (idempotent column adds still run)
# Default: false
#SKIP_DB_MIGRATIONS=true

# ============================================
# Cloud Storage (GCS)
# ============================================

# GCS bucket for storing AI reviews (required for cloud deployment)
#GCS_BUCKET=your-bucket-name

# ============================================
# Optional Configuration (Agentic Reviews)
# ============================================
# When AGENTIC_REVIEWS=true, every review pipes the Gemini comment set
# through a selectable agent subprocess for verification + refinement.
# Backend `claude` needs Claude Code; `openrouter` needs Codex CLI. The
# Dockerfile installs both.

# Enable the agent stage (default: false)
#AGENTIC_REVIEWS=true

# Where to clone PR repos for the agent's working directory.
# Default: ./data/agent-clones
#AGENT_CLONE_ROOT_DIR=./data/agent-clones

# Where to write raw stream-json transcripts for each agent run.
# Default: ./data/agent-logs
#AGENT_LOGS_DIR=./data/agent-logs

# Hard wall-clock cap per agent run. Covers clone + agent loop, so on a
# cold start (no warm git cache) you want headroom. Exceeding aborts loud.
# Default: 360 (6 minutes)
#AGENT_WALL_CLOCK_SEC=360

# Max number of agent reviews allowed to run concurrently in this process.
# Each one holds ~1 GB of /tmp (clone) + agent memory. With a 16 GiB
# instance, 2 is the sweet spot. <=0 safely falls back to 5.
# Default: 2
#AGENT_MAX_CONCURRENT=2

# Max backend-specific turn-budget units per agent run. Claude counts assistant
# stream events; OpenRouter/Codex counts completed non-reasoning work items and
# excludes its terminal answer. The capabilities API and each durable run
# snapshot expose the exact unit/version. Exceeding this aborts loud.
# Active default: 40 for Claude; 200 for OpenRouter
#AGENT_MAX_TURNS=40

# Agent CLI backend: claude | openrouter. Default: claude
#AGENT_BACKEND=claude

# Backend model id used for agent reviews. Backend defaults:
#   claude:     claude-opus-4-8
#   openrouter: openai/gpt-5.6-sol
# Use a complete OpenRouter slug, including its provider prefix.
#AGENT_MODEL=claude-opus-4-8

# Reasoning effort passed to the selected CLI. Default: medium.
# Claude supports low|medium|high; GPT-5.6 Sol also supports xhigh|max.
# Default: medium
#AGENT_EFFORT=medium

# Anthropic API key. Used to authenticate the `claude` CLI in containerized
# deployments where `claude login` isn't available (required by prod-like.sh
# only when AGENT_BACKEND=claude).
#ANTHROPIC_API_KEY=your_anthropic_key_here
# Existing Claude CLI auth/gateway variables CLAUDE_CODE_OAUTH_TOKEN,
# ANTHROPIC_AUTH_TOKEN, and ANTHROPIC_BASE_URL are also preserved for Claude
# children only; they are excluded from OpenRouter/Codex children.

# OpenRouter auth for AGENT_BACKEND=openrouter. Codex reads this variable
# directly; the key is never placed in subprocess arguments or JSONL logs.
#OPENROUTER_API_KEY=your_openrouter_key_here

# Optional custom OpenRouter API root. Default shown below.
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================
# Per-review customization policy
# ============================================
# Authenticated on-demand review callers may target any repository readable by
# the deployment's GitHub credentials, matching /api/prs/generate-review. Scope
# the GitHub App installation/token to the repositories this service may review.
# The review API may override model, effort, wall-clock, turn, and first-pass
# sample settings only within these operator-owned allowlists and ceilings.
# Comma-separated lists are trimmed and deduplicated. The active deployment
# model/effort is always admitted for its backend, so these settings do not
# switch or invalidate AGENT_BACKEND / AGENT_MODEL / AGENT_EFFORT.

# Claude models callers may select. Defaults shown below.
#REVIEW_AGENT_MODELS_CLAUDE=claude-opus-4-8,claude-fable-5

# OpenRouter models callers may select. Use complete provider/model slugs.
#REVIEW_AGENT_MODELS_OPENROUTER=openai/gpt-5.6-sol

# Backend-specific reasoning efforts callers may select. Defaults shown below.
#REVIEW_AGENT_EFFORTS_CLAUDE=low,medium,high
#REVIEW_AGENT_EFFORTS_OPENROUTER=low,medium,high,xhigh,max

# Gemini first-pass thinking level: low | medium | high. Empty keeps the
# provider default. Applies only when the first pass runs on Gemini; other
# first-pass providers ignore it.
#FIRST_PASS_THINKING=

# First-pass models callers may select per provider. Each list defaults to the
# provider's default model, and the active FIRST_PASS_PROVIDER/FIRST_PASS_MODEL
# is always admitted for its provider. A provider is offered only when its API
# key is configured on the server.
#REVIEW_FIRST_PASS_MODELS_GEMINI=gemini-3.1-pro-preview
#REVIEW_FIRST_PASS_MODELS_CLAUDE=claude-sonnet-5
#REVIEW_FIRST_PASS_MODELS_OPENROUTER=openai/gpt-5.6-sol

# Hard per-review ceilings. Unset wall-clock and sample values default to the
# active deployment and 3 samples. Unset turn ceilings stay backend-specific
# (40 Claude assistant events, 200 OpenRouter work items); setting
# REVIEW_MAX_TURNS applies one operator ceiling to both without invalidating the
# active deployment default. Each backend advertises its exact default and
# ceiling. Values must be positive integers; invalid values fall back safely.
#REVIEW_MAX_WALL_CLOCK_SEC=360
#REVIEW_MAX_TURNS=200
#REVIEW_MAX_FIRST_PASS_SAMPLES=3

# Process-global cap for concurrent first-pass pipelines. It also bounds the
# preflight cache/storage lookups that occur before provider work. Unlike the
# per-run sample count above, callers cannot override this deployment safety
# setting. Queued jobs wait for provider capacity before their execution clock
# and lease begin.
# Default: 5
#REVIEW_MAX_FIRST_PASS_CONCURRENT=5

# ============================================
# Deterministic review layer (gates + bug memory)
# ============================================
# Mechanical checks that run on the PR diff without any LLM. When a gate
# fires, its finding is injected into the agent's review context. All gates
# default OFF and most need repo-specific layout config to do anything.
# Preview what they'd contribute with: go run ./cmd/gatecheck <dir> <base>

#GATE_WIRING=true
#GATE_EFFECT_CLEANUP=true
#GATE_MIGRATION_RESIDUE=true
# Max surviving references before the residue gate stays quiet. Default: 20
#GATE_RESIDUE_MAX_SURVIVORS=20
# Both must be set or the topic gate is off
#GATE_TOPIC_BE_DIR=backend/
#GATE_TOPIC_FE_DIR=frontend/
# doublestar glob syntax; producer glob unset = gate off, consumer glob is
# an optional narrowing of where compat handling is searched for
#GATE_TASK_PRODUCER_GLOB=**/tasks/**
#GATE_TASK_CONSUMER_GLOB=**/workers/**

# Turn fired gates and bug-memory hits into forced checks the agent must
# answer with an explicit VIOLATED / SAFE / NOT-APPLICABLE verdict.
# Default: false
#REQUIRED_CHECKS=true

# Distilled library of past bug patterns injected per PR area.
# BUG_MEMORY_PATH (local file) wins over BUG_MEMORY_OBJECT (GCS object).
#BUG_MEMORY_PATH=./bug-memory.json
#BUG_MEMORY_OBJECT=bug-memory/bug-memory.json

# ============================================
# Feature flags (all default: false)
# ============================================

# Enable the /api/prs/finding-outcomes endpoints and the dashboard triage UI
# for marking findings correct/incorrect
#FINDING_OUTCOMES_ENABLED=true

# Carry prior-run findings forward as a union across commits of a PR
#CARRY_FORWARD_FINDINGS=true

# Archive prior review versions in GCS before overwriting
#REVIEW_HISTORY_ARCHIVE=true

# Pin a "Deterministic alerts" block with verdict badges to the top of
# rendered reviews
#SURFACE_ALERTS=true

# ============================================
# Cloud SQL (for prod-like.sh)
# ============================================

# Google Cloud Project ID
#GOOGLE_PROJECT_ID=your-project-id

# Cloud SQL instance connection name (format: project:region:instance)
#CLOUD_SQL_INSTANCE=your-project:us-central1:your-instance

# PostgreSQL connection URL (set automatically by prod-like.sh via Secret Manager)
# Format: postgres://user:password@localhost:5432/dbname?sslmode=disable
# If set, uses PostgreSQL instead of SQLite
#DATABASE_URL=

# ============================================
# Multi-User Mode (GitHub App + OAuth)
# ============================================
# Required for production deployments with multiple users.
# Create a GitHub App at: https://github.com/settings/apps

# GitHub App ID (found in app settings)
#GITHUB_APP_ID=123456

# Path to GitHub App private key file (.pem)
#GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem

# GitHub App Installation ID (found after installing the app)
#GITHUB_APP_INSTALLATION_ID=12345678

# OAuth credentials (found in app settings under "Client secrets")
#GITHUB_APP_CLIENT_ID=Iv1.abc123
#GITHUB_APP_CLIENT_SECRET=your_client_secret

# GitHub organization name (for membership verification)
#GITHUB_ORG_NAME=your-org-name

# Base URL for the application (used for OAuth callbacks)
#BASE_URL=https://pr-review.example.com

# OAuth callback URL (must match GitHub App settings)
# The server registers the callback at /auth/github/callback
#OAUTH_CALLBACK_URL=https://pr-review.example.com/auth/github/callback

# Session secret for cookie encryption (generate with: openssl rand -hex 32)
#SESSION_SECRET=your_random_secret_here
