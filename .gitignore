# Binaries
pr-review-server
bin/*
!bin/.gitkeep
!bin/*.sh

# Database
*.db
*.db-journal

# Reviews
reviews/

# Environment files (keep .env.example)
.env
.env.*
!.env.example

# Logs and debug files
*.log
*.log.*
server.pid

# Internal development docs (not for distribution)
TODO.md
TODO-*.md
CLAUDE.md
GEMINI.md

# Go
vendor/
server/dist/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Docker volumes (ignore contents, not the dir itself — so we can track
# agent-review scratch subdirs with .gitkeep placeholders)
data/*
!data/agent-clones/
!data/agent-logs/
data/agent-clones/*
data/agent-logs/*
!data/agent-clones/.gitkeep
!data/agent-logs/.gitkeep

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Certificates and keys
*.pem
*.key

# Claude Code
.claude/
cloud-sql-proxy

# Local-only ops docs — never commit
ARCHITECTURE.md
DEPLOY.md
DEPLOYMENT.md

# Local eval harness: private data (case manifests, run artifacts); never commit.
# benchmark/replay and benchmark/commentbench hold only their published baselines; their outputs name real repositories.
benchmark/*
!benchmark/replay/
benchmark/replay/*
!benchmark/replay/BASELINE.md
!benchmark/replay/W1-1.md
!benchmark/replay/W2-3.md
!benchmark/commentbench/
benchmark/commentbench/*
!benchmark/commentbench/BASELINE.md
