{{define "diff-file"}}
{{$filePath := .File.Path}}
{{if .File.Skipped}}
<div class="diff-file">
    <div class="file-header file-skipped">{{$filePath}}: not rendered ({{.File.LineLabel}}){{if $.Root.PRURL}} <a href="{{$.Root.PRURL}}/files">view on GitHub</a>{{end}}</div>
</div>
{{else}}
{{if .File.Collapsed}}
<details class="diff-file">
    <summary class="file-header">{{$filePath}} ({{.File.LineLabel}})</summary>
{{else}}
<div class="diff-file">
    <div class="file-header">{{$filePath}}{{if .File.Note}} <span class="file-note">{{.File.Note}}</span>{{end}}</div>
{{end}}
    <div class="diff-table">
        {{/* Whole-file findings (LineNumber 0) render once, under the header.
             Keying them per-line would repeat them on every deleted line,
             since deleted lines carry NewLineNumber 0. */}}
        {{$fileComments := index (index $.Root.Comments $filePath) 0}}
        {{if $fileComments}}
        <div class="comment-row">
            <div class="line-num"></div><div class="line-num"></div>
            <div class="comment-cell">
                {{range $fileComments}}
                <div class="comment-body">
                    {{template "comment-counter" .}}
                    {{template "finding-body" .}}
                    {{template "verification-note" .}}
                </div>
                {{end}}
            </div>
        </div>
        {{end}}
        {{range .File.Lines}}
        {{if eq .Type "gap"}}
        <div class="hunk-gap">
            <div class="line-num"></div><div class="line-num"></div>
            <div class="hunk-gap-text">{{.Content}}</div>
        </div>
        {{else}}
        <div class="line {{.Type}}">
            <div class="line-num">{{if eq .OldLineNumber 0}}-{{else}}{{.OldLineNumber}}{{end}}</div>
            <div class="line-num">{{if eq .NewLineNumber 0}}-{{else}}{{.NewLineNumber}}{{end}}</div>
            <div class="line-content">{{.Content}}{{if .Truncated}}<span class="line-truncated">line truncated</span>{{end}}</div>
        </div>
        {{$comments := ""}}
        {{if ne .NewLineNumber 0}}{{$comments = index (index $.Root.Comments $filePath) .NewLineNumber}}{{end}}
        {{if $comments}}
        <div class="comment-row">
            <div class="line-num"></div><div class="line-num"></div>
            <div class="comment-cell">
                {{range $comments}}
                <div class="comment-body">
                    {{template "comment-counter" .}}
                    {{template "finding-body" .}}
                    {{template "verification-note" .}}
                </div>
                {{end}}
            </div>
        </div>
        {{end}}
        {{end}}
        {{end}}
    </div>
{{if .File.Collapsed}}</details>{{else}}</div>{{end}}
{{end}}
{{end}}
