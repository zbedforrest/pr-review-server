{{define "alert-rows"}}
        {{range .}}
        <div class="deterministic-alert">
            <div class="deterministic-alert-meta">
                <span class="alert-badge alert-provenance">{{.Provenance}}</span>
                <span class="alert-location">{{.FilePath}}{{if .LineNumber}}:{{.LineNumber}}{{end}}</span>
                {{if .Verdict}}<span class="alert-badge alert-verdict alert-verdict-{{.VerdictClass}}">{{if .CheckID}}{{.CheckID}} · {{end}}{{.Verdict}}{{if .Evidence}} ({{.Evidence}}){{end}}</span>{{end}}
            </div>
            <div class="deterministic-alert-body">{{.Body | markdownify}}</div>
        </div>
        {{end}}
{{end}}

{{define "status-pill"}}{{if .StatusPill}}<span class="status-pill status-{{.StatusClass}}">{{.StatusPill}}</span>{{end}}{{end}}

{{define "counterargument"}}{{if .Assessment}}
<div class="counterargument"><span class="counterargument-label">Agent rejected:</span> {{.Assessment.Reason}}{{range .Assessment.Evidence}} <span class="evidence-ref">{{.File}}{{if .Line}}:{{.Line}}{{end}}</span>{{end}}</div>
{{end}}{{end}}

{{define "record-rows"}}
        {{range .}}
        <div class="record-row">
            <div class="record-meta">
                <span class="sev-pill sev-{{.SeverityClass}}">{{if .Severity}}{{.Severity}}{{else}}NOTE{{end}}</span>
                <span class="record-location">{{.Location}}</span>
            </div>
            <div class="record-claim">{{.Claim | markdownify}}</div>
            {{if .Reason}}<div class="record-reason">Rejected because: {{.Reason}}</div>{{end}}
            {{if .Evidence}}<div class="record-evidence">Evidence:{{range .Evidence}} <span class="evidence-ref">{{.}}</span>{{end}}</div>{{end}}
            {{if .MergedInto}}<div class="record-merged">folded into {{if .MergedAnchor}}<a href="#{{.MergedAnchor}}">{{.MergedInto}}</a>{{else}}{{.MergedInto}}{{end}}{{if .MergeBasis}} ({{if eq .MergeBasis "proximity"}}same file, nearby line; the agent did not link them{{else}}linked by the agent{{end}}){{end}}</div>{{end}}
        </div>
        {{end}}
{{end}}

{{define "report-content"}}
    {{if .PinnedAlerts}}
    <div class="deterministic-alerts pinned">
        <h2>Deterministic alerts</h2>
        <p class="deterministic-alerts-note">Zero-LLM signals from mechanical gates and required-check enforcement. Each fired on this PR's diff; verify each one manually, the review prose below cannot clear them.</p>
        {{template "alert-rows" .PinnedAlerts}}
    </div>
    {{end}}

    <div class="pr-description">
        <h2>PR Description</h2>
        {{if .Description.Folded}}
        <div class="pr-description-preview">{{.Description.Preview}}</div>
        <details class="pr-description-fold">
            <summary>Read full PR description</summary>
            <div class="pr-description-full">{{.Description.Full}}</div>
        </details>
        {{else}}
        {{.Description.Full}}
        {{end}}
    </div>

    <div class="verdict-block" data-verdict="{{.VerdictClass}}">
        <div class="verdict-main">
            <div class="verdict-text">{{.Verdict}}</div>
            {{if .Upshot}}<div class="verdict-upshot">{{.Upshot}}</div>{{end}}
        </div>
        <div class="verdict-counts">
            <span class="count-pill count-confirmed">{{.ConfirmedCount}} confirmed</span>
            {{if .UnverifiedCount}}<span class="count-pill count-unverified">{{.UnverifiedCount}} unverified</span>{{end}}
            {{if .MechanicalCount}}<span class="count-pill count-mechanical">{{.MechanicalCount}} mechanical</span>{{end}}
            {{if .RejectedCount}}<span class="count-pill count-rejected">{{.RejectedCount}} rejected</span>{{end}}
        </div>
    </div>

    {{if .NextActions}}
    <div class="suggestions-section">
        <h2>Next actions</h2>
        <ol class="next-actions">
            {{range .NextActions}}
            <li class="next-action">
                <span class="sev-pill sev-{{.SeverityClass}}">{{if .Severity}}{{.Severity}}{{else}}NOTE{{end}}</span>
                <a class="next-action-title" href="#{{.AnchorID}}">{{.Title}}</a>
                <span class="finding-location">{{.Location}}</span>
            </li>
            {{end}}
        </ol>
    </div>
    {{else if .Suggestions}}
    <div class="suggestions-section">
        <h2>Suggestions</h2>
        <div class="suggestions-body">{{.Suggestions | markdownify}}</div>
    </div>
    {{end}}

    {{if .Summaries}}
    <div class="summary-section">
        <h2>Review Summary</h2>
        {{range .Summaries}}
        <div class="summary-comment">
            {{template "comment-counter" .CommentView}}
            <div class="summary-body">
                {{.Prose | markdownify}}
            </div>
        </div>
        {{end}}
    </div>
    {{end}}

    {{if .FindingGroups}}
    <div class="findings-index">
        <h2>Findings</h2>
        {{range .FindingGroups}}
        <h3>{{.Name}}</h3>
        <ul class="findings-list">
            {{range .Rows}}
            <li class="finding-row">
                <span class="sev-pill sev-{{.SeverityClass}}">{{if .Severity}}{{.Severity}}{{else}}NOTE{{end}}</span>
                {{template "status-pill" .}}
                <a class="finding-location" href="#{{.AnchorID}}">{{.FilePath}}{{if .LineNumber}}:{{.LineNumber}}{{end}}</a>
                <span class="finding-title">{{.Title}}</span>
            </li>
            {{end}}
        </ul>
        {{end}}
    </div>
    {{end}}

    {{if .GeneralComments}}
    <div class="general-section">
        <h2>General Comments</h2>
        {{range .GeneralComments}}
        <div class="general-comment">
            {{template "comment-counter" .}}
            <div class="general-body">
                {{.CommentBody | markdownify}}
                {{template "counterargument" .}}
            </div>
        </div>
        {{end}}
    </div>
    {{end}}

    {{$root := .}}
    {{range .Files}}
        {{template "diff-file" (dict "File" . "Root" $root)}}
    {{end}}

    {{if .AdjacentComments}}
    <div class="adjacent-section">
        <h2>Adjacent File-Specific Comments</h2>
        <p class="adjacent-explanation">These comments reference specific files and lines adjacent to but not explicitly in the original diff.</p>
        {{range .AdjacentComments}}
        <div class="diff-file">
            <div class="file-header">{{.FilePath}}:{{.LineNumber}}</div>
            <div class="diff-table">
                {{if .ContextLines}}
                {{range .ContextLines}}
                <div class="line context{{if .IsTarget}} target-line{{end}}">
                    <div class="line-num">-</div>
                    <div class="line-num">{{.LineNumber}}</div>
                    <div class="line-content">{{.Content}}</div>
                </div>
                {{end}}
                {{end}}
                <div class="comment-row">
                    <div class="line-num"></div><div class="line-num"></div>
                    <div class="comment-cell">
                        <div class="comment-body">
                            {{template "comment-counter" .}}
                            {{.CommentBody | markdownify}}
                            {{template "counterargument" .}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{end}}
    </div>
    {{end}}

    <details class="review-details">
        <summary>Review details</summary>
        {{if .Rejected}}
        <h3>Rejected after investigation</h3>
        {{template "record-rows" .Rejected}}
        {{end}}
        {{if .Unexamined}}
        <h3>First-pass claims not examined</h3>
        {{template "record-rows" .Unexamined}}
        {{end}}
        {{if .Merged}}
        <h3>Merged claims</h3>
        {{template "record-rows" .Merged}}
        {{end}}
        {{if .Checks}}
        <h3>Required checks</h3>
        <div class="checks-table-wrap">
        <table class="checks-table">
            <thead><tr><th>id</th><th>source</th><th>verdict</th><th>evidence</th><th>question</th><th>answer</th></tr></thead>
            <tbody>
            {{range .Checks}}
            <tr class="{{if .Unresolved}}check-unresolved{{end}}">
                <td class="check-id">{{.ID}}</td>
                <td>{{.Source}}</td>
                <td><span class="alert-badge alert-verdict alert-verdict-{{.VerdictClass}}">{{.Verdict}}</span>{{if .Unresolved}} <span class="unresolved-marker">unresolved</span>{{end}}</td>
                <td>{{.EvidenceLabel}}{{if .EvidencePath}} <span class="check-evidence-path">{{.EvidencePath}}</span>{{end}}</td>
                <td>{{.Question}}{{if .TargetFile}} <span class="check-target">({{.TargetFile}})</span>{{end}}</td>
                <td>{{.Answer}}</td>
            </tr>
            {{end}}
            </tbody>
        </table>
        </div>
        {{end}}
        {{if .DeterministicAlerts}}
        <div class="deterministic-alerts">
            <h3>Deterministic alerts</h3>
            <p class="deterministic-alerts-note">Zero-LLM signals from mechanical gates and required-check enforcement. Each fired on this PR's diff; verify each one manually, the review prose cannot clear them.</p>
            {{template "alert-rows" .DeterministicAlerts}}
        </div>
        {{end}}
        <h3>Generation</h3>
        <p class="generation-meta">Model: {{.ModelName}}</p>
        <p class="generation-meta">Prompt tokens: {{.PromptTokenCount}} · Candidate tokens: {{.CandidatesTokenCount}} · Total tokens (all requests): {{.TotalTokenCount}}</p>
        <p class="generation-meta">The full prompt is available from the Prompt handle on the right edge of the page.</p>
    </details>
{{end}}
