{{define "alert-rows"}}
        {{range .}}
        <div class="deterministic-alert">
            <div class="deterministic-alert-meta">
                <span class="alert-badge alert-provenance">{{.Provenance}}</span>
                <span class="alert-location">{{.FilePath}}{{if .LineNumber}}:{{.LineNumber}}{{end}}</span>
                {{if .Verdict}}<span class="alert-badge alert-verdict alert-verdict-{{.VerdictClass}}">{{if .CheckID}}{{.CheckID}} · {{end}}{{.Verdict}}{{if .Evidence}} ({{.Evidence}}){{end}}</span>{{end}}
            </div>
            <div class="deterministic-alert-body">{{.Body | markdownify}}</div>
        </div>
        {{end}}
{{end}}

{{define "status-pill"}}{{if .StatusPill}}<span class="status-pill status-{{.StatusClass}}">{{.StatusPill}}</span>{{end}}{{end}}

{{define "verify-pill"}}{{if .VerifyPill}}<span class="status-pill verify-pill verify-{{.VerifyClass}} has-note" tabindex="0" data-note="{{.VerifyNote}}">{{.VerifyPill}}</span>{{end}}{{end}}

{{define "finding-detail-line"}}{{if .}}<p>{{. | markdownInline}}</p>{{end}}{{end}}

{{define "finding-verify"}}{{if .Detail.VerifyCondition}}<p><strong>How to verify:</strong> {{.Detail.VerifyCondition | markdownInline}}. Expected: {{.Detail.VerifyExpected | markdownInline}}.</p>{{end}}{{end}}

{{define "finding-body"}}{{if .DisplayBody}}
<div class="finding-display"><div class="finding-display-title">{{.DisplayTitle | markdownInline}}</div>{{.DisplayBody | markdownify}}</div>
<details class="finding-reasoning"><summary>Reasoning and how to verify</summary>
{{template "finding-detail-line" .Detail.Impact}}{{.CommentBody | markdownify}}{{template "finding-detail-line" .Detail.Uncertainty}}{{template "finding-verify" .}}
</details>
{{else}}{{.CommentBody | markdownify}}{{if .HasDetail}}
<details class="finding-reasoning"><summary>Impact and how to verify</summary>
{{template "finding-detail-line" .Detail.Impact}}{{template "finding-detail-line" .Detail.Uncertainty}}{{template "finding-verify" .}}
</details>
{{end}}{{end}}{{if .AlsoCovers}}
<div class="also-covers">Also covers:{{range $i, $t := .AlsoCovers}}{{if $i}};{{end}} {{$t | markdownInline}}{{end}}</div>
{{end}}{{end}}

{{define "verification-note"}}{{if .VerifyReasons}}
<div class="verification-note verify-note-{{.VerifyClass}}"><span class="verification-note-label">{{.VerifyPill}}</span>{{range .VerifyReasons}}<div class="verification-reason">{{. | markdownInline}}</div>{{end}}</div>
{{end}}{{end}}

{{define "held-marker"}}<summary class="held-marker" title="{{.HeldReason}}"><span class="status-pill status-held">{{.FoldLabel}}</span></summary>{{end}}

{{define "held-note"}}{{if .HeldReason}}
<div class="held-note"><span class="held-note-label">Not posted</span> PRism held this back because {{.HeldReason}}.</div>
{{end}}{{end}}

{{define "record-rows"}}
        {{range .}}
        <div class="record-row">
            <div class="record-meta">
                <span class="sev-pill sev-{{.SeverityClass}}">{{if .Severity}}{{.Severity}}{{else}}NOTE{{end}}</span>
                {{if .Anchor}}<a class="record-location" href="#{{.Anchor}}">{{.Location}}</a>{{else}}<span class="record-location">{{.Location}}</span>{{end}}
            </div>
            {{if .Claim}}<div class="record-claim">{{.Claim | markdownify}}</div>{{end}}
            {{if .Reason}}<div class="record-reason">{{if .Label}}{{.Label}}{{else if .Anchor}}Reviewer's objection{{else}}Rejected because{{end}}: {{.Reason | markdownInline}}</div>{{end}}
            {{if .Evidence}}<div class="record-evidence">Evidence:{{range .Evidence}} <span class="evidence-ref">{{.}}</span>{{end}}</div>{{end}}
        </div>
        {{end}}
{{end}}

{{define "short-list"}}
        <div class="fix-first">
            <div class="fix-first-head">
                <span class="fix-first-title">{{.Title}}</span>
                <span class="fix-first-sub">{{.Sub}}</span>
            </div>
            <ol class="fix-first-list">
                {{range .Items}}
                <li class="next-action">
                    <span class="sev-pill sev-{{.SeverityClass}}">{{if .Severity}}{{.Severity}}{{else}}NOTE{{end}}</span>
                    {{template "verify-pill" .}}
                    <a class="fix-first-title-link" href="#{{.AnchorID}}">{{.Title | markdownInline}}</a>
                    <span class="finding-location">{{.Location}}</span>
                </li>
                {{end}}
            </ol>
        </div>
{{end}}

{{define "report-content"}}
    {{if .PinnedAlerts}}
    <div class="deterministic-alerts pinned">
        <h2>Deterministic alerts</h2>
        <p class="deterministic-alerts-note">Zero-LLM signals from mechanical gates and required-check enforcement. Each fired on this PR's diff; verify each one manually, the review prose below cannot clear them.</p>
        {{template "alert-rows" .PinnedAlerts}}
    </div>
    {{end}}

    <div class="pr-description">
        <h2>PR Description</h2>
        {{if .Description.Folded}}
        <div class="pr-description-preview">{{.Description.Preview}}</div>
        <details class="pr-description-fold">
            <summary>Read full PR description</summary>
            <div class="pr-description-full">{{.Description.Full}}</div>
        </details>
        {{else}}
        {{.Description.Full}}
        {{end}}
    </div>

    <div class="verdict-block" data-verdict="{{.VerdictClass}}">
        <div class="verdict-main">
            <div class="verdict-text">{{.Verdict}}</div>
            {{if .PostedLine}}<div class="verdict-upshot">{{.PostedLine}}</div>{{end}}
            {{if .Upshot}}<div class="verdict-upshot">{{.Upshot | markdownInline}}</div>{{end}}
        </div>
        <div class="verdict-counts">
            <span class="count-pill count-confirmed">{{.ConfirmedCount}} confirmed</span>
            {{if .UnsettledCount}}<span class="count-pill count-unverified" title="The verifier looked but the repository could not settle these claims.">{{.UnsettledCount}} could not verify</span>{{end}}
            {{if .UnverifiedCount}}<span class="count-pill count-unverified">{{.UnverifiedCount}} unverified</span>{{end}}
            {{if .MechanicalCount}}<span class="count-pill count-mechanical">{{.MechanicalCount}} mechanical</span>{{end}}
            {{if .RejectedCount}}<span class="count-pill count-rejected">{{.RejectedCount}} rejected</span>{{end}}
            {{if .HeldCount}}<a class="count-pill count-withheld" href="#held-back" title="{{if .HeldInDiff}}Folded where they sit in the diff.{{else}}Listed at the end of the page.{{end}}">{{.HeldCount}} held back</a>{{end}}
        </div>
        {{if .VerifyCounts}}
        <div class="verify-counts">
            <span class="verify-counts-label">Verification</span>
            {{range .VerifyCounts}}<span class="status-pill verify-pill verify-{{.Class}}">{{.Count}} {{.Label}}</span>{{end}}
        </div>
        {{end}}
        {{if .TopFindings}}{{template "short-list" (dict "Title" "Most severe" "Sub" "The full list follows." "Items" .TopFindings)}}{{end}}
        {{if .FixFirst}}{{template "short-list" (dict "Title" "Fix first" "Sub" "The reviewer's pick of the findings below; the full list follows." "Items" .FixFirst)}}{{end}}
    </div>

    {{if .Suggestions}}
    <div class="suggestions-section">
        <h2>Suggestions</h2>
        <div class="suggestions-body">{{.Suggestions | markdownify}}</div>
    </div>
    {{end}}

    {{if .Summaries}}
    <div class="summary-section">
        <h2>Review Summary</h2>
        {{range .Summaries}}
        <div class="summary-comment">
            {{template "comment-counter" .CommentView}}
            <div class="summary-body">
                {{.Prose | markdownify}}
            </div>
        </div>
        {{end}}
    </div>
    {{end}}

    {{if .FindingGroups}}
    <div class="findings-index">
        <h2>Findings</h2>
        {{range .FindingGroups}}
        {{$held := eq .Name "Held back"}}
        {{if $held}}<details class="held-index" id="held-back"><summary><span class="status-pill status-held">{{len .Rows}} held back</span></summary>{{else}}<h3>{{.Name}}</h3>{{end}}
        {{if .Hint}}<p class="group-hint">{{.Hint}}</p>{{end}}
        <ul class="findings-list">
            {{range .Rows}}
            <li class="finding-row">
                <span class="sev-pill sev-{{.SeverityClass}}">{{if .Severity}}{{.Severity}}{{else}}NOTE{{end}}</span>
                {{template "status-pill" .}}
                {{template "verify-pill" .}}
                <a class="finding-location" href="#{{.AnchorID}}">{{.FilePath}}{{if .LineNumber}}:{{.LineNumber}}{{end}}</a>
                <span class="finding-title">{{.Title | markdownInline}}</span>
            </li>
            {{end}}
        </ul>
        {{if $held}}</details>{{end}}
        {{end}}
    </div>
    {{end}}

    {{if .GeneralComments}}
    <div class="general-section">
        <h2>General Comments</h2>
        {{range .GeneralComments}}
        {{if .Folded}}<details class="held-fold" id="{{.AnchorID}}">{{template "held-marker" .}}{{end}}
        <div class="general-comment">
            {{template "comment-counter" .}}
            <div class="general-body">
                {{template "finding-body" .}}
                {{template "held-note" .}}
                {{template "verification-note" .}}
            </div>
        </div>
        {{if .Folded}}</details>{{end}}
        {{end}}
    </div>
    {{end}}

    {{$root := .}}
    {{range .Files}}
        {{template "diff-file" (dict "File" . "Root" $root)}}
    {{end}}

    {{if .AdjacentComments}}
    <div class="adjacent-section">
        <h2>Adjacent File-Specific Comments</h2>
        <p class="adjacent-explanation">These comments reference specific files and lines adjacent to but not explicitly in the original diff.</p>
        {{range .AdjacentComments}}
        {{if .Folded}}<details class="diff-file held-fold" id="{{.AnchorID}}">
            <summary class="file-header held-marker" title="{{.HeldReason}}">{{.FilePath}}:{{.LineNumber}} <span class="status-pill status-held">{{.FoldLabel}}</span></summary>
        {{else}}<div class="diff-file">
            <div class="file-header">{{.FilePath}}:{{.LineNumber}}</div>{{end}}
            <div class="diff-table">
                {{if .ContextLines}}
                {{range .ContextLines}}
                <div class="line context{{if .IsTarget}} target-line{{end}}">
                    <div class="line-num">-</div>
                    <div class="line-num">{{.LineNumber}}</div>
                    <div class="line-content">{{.Content}}</div>
                </div>
                {{end}}
                {{end}}
                <div class="comment-row">
                    <div class="line-num"></div><div class="line-num"></div>
                    <div class="comment-cell">
                        <div class="comment-body">
                            {{template "comment-counter" .}}
                            {{template "finding-body" .}}
                {{template "held-note" .}}
                {{template "verification-note" .}}
                        </div>
                    </div>
                </div>
            </div>
        {{if .Folded}}</details>{{else}}</div>{{end}}
        {{end}}
    </div>
    {{end}}

    {{if .Held}}
    <details class="review-details held-back" id="held-back">
        <summary>Held back ({{len .Held}})</summary>
        <p class="group-hint">The review found these but PRism kept them off the PR. Each says why.</p>
        {{template "record-rows" .Held}}
    </details>
    {{end}}

    <details class="review-details">
        <summary>Review details</summary>
        {{if or .Rejected .Unexamined}}
        <h3>Not posted</h3>
        {{if .Rejected}}
        <h4>Rejected after investigation</h4>
        {{template "record-rows" .Rejected}}
        {{end}}
        {{if .Unexamined}}
        <h4>First-pass claims not examined</h4>
        {{template "record-rows" .Unexamined}}
        {{end}}
        {{end}}
        {{if .Disputed}}
        <h3>Posted over the reviewer's objection</h3>
        {{template "record-rows" .Disputed}}
        {{end}}
        {{if .Checks}}
        <h3>Required checks</h3>
        <div class="checks-table-wrap">
        <table class="checks-table">
            <thead><tr><th>id</th><th>source</th><th>verdict</th><th>evidence</th><th>question</th><th>answer</th></tr></thead>
            <tbody>
            {{range .Checks}}
            <tr class="{{if .Unresolved}}check-unresolved{{end}}">
                <td class="check-id">{{.ID}}</td>
                <td>{{.Source}}</td>
                <td><span class="alert-badge alert-verdict alert-verdict-{{.VerdictClass}}">{{.Verdict}}</span>{{if .Unresolved}} <span class="unresolved-marker">unresolved</span>{{end}}</td>
                <td>{{.EvidenceLabel}}{{if .EvidencePath}} <span class="check-evidence-path">{{.EvidencePath}}</span>{{end}}</td>
                <td>{{.Question}}{{if .TargetFile}} <span class="check-target">({{.TargetFile}})</span>{{end}}</td>
                <td>{{.Answer}}</td>
            </tr>
            {{end}}
            </tbody>
        </table>
        </div>
        {{end}}
        {{if .DeterministicAlerts}}
        <div class="deterministic-alerts">
            <h3>Deterministic alerts</h3>
            <p class="deterministic-alerts-note">Zero-LLM signals from mechanical gates and required-check enforcement. Each fired on this PR's diff; verify each one manually, the review prose cannot clear them.</p>
            {{template "alert-rows" .DeterministicAlerts}}
        </div>
        {{end}}
        <h3>Generation</h3>
        {{if .Stages}}
        <div class="stage-table-wrap">
        <table class="stage-table">
            <thead><tr><th>Stage</th><th>Model</th><th>Result</th><th>Time</th><th>Cost</th></tr></thead>
            <tbody>
            {{range .Stages}}<tr><td>{{.Name}}</td><td>{{.Model}}</td><td>{{.Detail}}</td><td>{{.Duration}}</td><td>{{.Cost}}</td></tr>
            {{end}}
            </tbody>
            {{if .StagesCost}}<tfoot><tr><td colspan="4">Total</td><td>{{.StagesCost}}</td></tr></tfoot>{{end}}
        </table>
        </div>
        <p class="generation-meta">Kept, revised, good and ok findings can post; held back, refuted and bad ones do not.</p>
        <p class="generation-meta">Findings on this page: {{.ShownCount}}.{{if .HeldCount}} Held back by verification, the quality gate or publishing: {{.HeldCount}}.{{end}}</p>
        {{else}}
        <p class="generation-meta">Model: {{.ModelName}}</p>
        <p class="generation-meta">Input tokens: {{.PromptTokenCount}} · Output tokens: {{.CandidatesTokenCount}}</p>
        {{end}}
    </details>
{{end}}
