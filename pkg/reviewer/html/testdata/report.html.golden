    <div class="help-tooltip">
      Press J to scroll to next review comment<br>
      Press K to scroll to previous review comment
    </div>

    
<div id="chat-sidebar" class="chat-sidebar">
    <div id="chat-handle" class="chat-handle">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        <span>Chat</span>
    </div>
    <div id="prompt-handle" class="chat-handle prompt-handle">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"></path></svg>
        <span>Prompt</span>
    </div>
    <div class="chat-content">
        <h3>Chat with AI</h3>
        <div id="chat-messages" class="chat-messages">
            <div class="message assistant">
                Hello! Ask me anything about this PR, the code, or my review.
            </div>
        </div>
        <div class="chat-input">
            <textarea id="chat-textarea" placeholder="Type your message..." rows="3"></textarea>
            <button id="chat-send-btn">Send</button>
        </div>
    </div>
    <div class="prompt-content" id="prompt-content">
        <h3>PR Prompt</h3>
        <div class="prompt-body"><p>TEST_PROMPT_PLACEHOLDER</p>
</div>
    </div>
</div>


    <script>
    const GEMINI_API_KEY = "";
    const RAW_DIFF = `diff --git a\/src\/utils\/calculator.test.ts b\/src\/utils\/calculator.test.ts\nnew file mode 100644\nindex 000000000000..7ee6cbdb5719\n--- \/dev\/null\n\u002b\u002b\u002b b\/src\/utils\/calculator.test.ts\n@@ -0,0 \u002b1,96 @@\n\u002bimport \u007b Calculator \u007d from \u0022.\/calculator\u0022;\n\u002b\n\u002b\/**\n\u002b * Creates a promise that can be resolved from outside its constructor.\n\u002b * @returns An object with the promise and its resolve function.\n\u002b *\/\n\u002bfunction createControllablePromise\u003cT\u003e() \u007b\n\u002b    let resolve: (value: T | PromiseLike\u003cT\u003e) =\u003e void = () =\u003e \u007b \u007d;\n\u002b    const promise = new Promise\u003cT\u003e(res =\u003e \u007b\n\u002b        resolve = res;\n\u002b    \u007d);\n\u002b    return \u007b promise, resolve \u007d;\n\u002b\u007d\n\u002b\n\u002bdescribe(\u0022Calculator\u0022, () =\u003e \u007b\n\u002b    let calculator: Calculator;\n\u002b\n\u002b    beforeEach(() =\u003e \u007b\n\u002b        calculator = new Calculator();\n\u002b    \u007d);\n\u002b\n\u002b    afterEach(() =\u003e \u007b\n\u002b        calculator.reset();\n\u002b    \u007d);\n\u002b\n\u002b    test(\u0022should add two numbers\u0022, () =\u003e \u007b\n\u002b        expect(calculator.add(2, 3)).toBe(5);\n\u002b        expect(calculator.add(-1, 1)).toBe(0);\n\u002b        expect(calculator.add(0, 0)).toBe(0);\n\u002b    \u007d);\n\u002b\n\u002b    test(\u0022should subtract two numbers\u0022, () =\u003e \u007b\n\u002b        expect(calculator.subtract(5, 3)).toBe(2);\n\u002b        expect(calculator.subtract(1, 1)).toBe(0);\n\u002b        expect(calculator.subtract(0, 5)).toBe(-5);\n\u002b    \u007d);\n\u002b\n\u002b    test(\u0022should multiply two numbers\u0022, () =\u003e \u007b\n\u002b        expect(calculator.multiply(2, 3)).toBe(6);\n\u002b        expect(calculator.multiply(-2, 3)).toBe(-6);\n\u002b        expect(calculator.multiply(0, 100)).toBe(0);\n\u002b    \u007d);\n\u002b\n\u002b    test(\u0022should divide two numbers\u0022, () =\u003e \u007b\n\u002b        expect(calculator.divide(6, 2)).toBe(3);\n\u002b        expect(calculator.divide(5, 2)).toBe(2.5);\n\u002b        expect(calculator.divide(0, 5)).toBe(0);\n\u002b    \u007d);\n\u002b\n\u002b    test(\u0022should throw error when dividing by zero\u0022, () =\u003e \u007b\n\u002b        expect(() =\u003e calculator.divide(5, 0)).toThrow(\u0022Cannot divide by zero\u0022);\n\u002b    \u007d);\n\u002b\n\u002b    test(\u0022should handle async operations\u0022, async () =\u003e \u007b\n\u002b        const \u007b promise, resolve \u007d = createControllablePromise\u003cnumber\u003e();\n\u002b\n\u002b        const resultPromise = calculator.asyncAdd(2, 3);\n\u002b        resolve(5);\n\u002b\n\u002b        await expect(resultPromise).resolves.toBe(5);\n\u002b    \u007d);\n\u002b\n\u002b    test(\u0022should maintain history of operations\u0022, () =\u003e \u007b\n\u002b        calculator.add(1, 2);\n\u002b        calculator.subtract(5, 3);\n\u002b        calculator.multiply(2, 4);\n\u002b\n\u002b        const history = calculator.getHistory();\n\u002b        expect(history).toHaveLength(3);\n\u002b        expect(history[0]).toEqual(\u007b operation: \u0022add\u0022, a: 1, b: 2, result: 3 \u007d);\n\u002b    \u007d);\n\u002b\n\u002b    test(\u0022should clear history on reset\u0022, () =\u003e \u007b\n\u002b        calculator.add(1, 2);\n\u002b        calculator.reset();\n\u002b\n\u002b        expect(calculator.getHistory()).toHaveLength(0);\n\u002b    \u007d);\n\u002b\u007d);\n`;
    const PR_BODY = `\u003ch2\u003eSummary\u003c\/h2\u003e\n\n\u003cp\u003eThis PR adds unit tests for the Calculator utility class.\u003c\/p\u003e\n\n\u003ch2\u003eChanges\u003c\/h2\u003e\n\n\u003cul\u003e\n\u003cli\u003eAdd test file for Calculator class\u003c\/li\u003e\n\u003cli\u003eTest basic arithmetic operations (add, subtract, multiply, divide)\u003c\/li\u003e\n\u003cli\u003eTest error handling for division by zero\u003c\/li\u003e\n\u003cli\u003eTest async operations\u003c\/li\u003e\n\u003cli\u003eTest history tracking feature\u003c\/li\u003e\n\u003cli\u003eTest reset functionality\u003c\/li\u003e\n\u003c\/ul\u003e\n\n\u003ch2\u003eTesting\u003c\/h2\u003e\n\n\u003cp\u003eRun tests with:\u003c\/p\u003e\n\n\u003cpre\u003e\u003ccode class=\u0022language-bash\u0022\u003enpm test -- --testPathPattern=calculator\n\u003c\/code\u003e\u003c\/pre\u003e\n\n\u003ch2\u003eChecklist\u003c\/h2\u003e\n\n\u003cul\u003e\n\u003cli\u003e[x] Tests pass locally\u003c\/li\u003e\n\u003cli\u003e[x] Code follows project style guidelines\u003c\/li\u003e\n\u003cli\u003e[x] Documentation updated if needed\u003c\/li\u003e\n\u003c\/ul\u003e\n`;

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.comment-body pre code').forEach((block) => {
            hljs.highlightElement(block);
        });

        const comments = document.querySelectorAll('.comment-body, .summary-comment, .general-comment');
        const totalComments = comments.length;

        comments.forEach((comment, index) => {
            const counterDiv = comment.querySelector('.comment-counter');
            if (counterDiv) {
                counterDiv.textContent = `Comment ${index + 1} of ${totalComments}`;
            }
        });

        let currentCommentIndex = -1;

        document.addEventListener('keydown', (e) => {
            const key = (e.key || '').toLowerCase();
            if (key === 'j' || key === 'k') {
                const activeElement = document.activeElement;
                const chatSidebar = document.getElementById('chat-sidebar');
                const isTypingInChat = activeElement && (
                    activeElement.id === 'chat-textarea' ||
                    (chatSidebar && chatSidebar.contains(activeElement))
                );

                if (!isTypingInChat) {
                    e.preventDefault();
                    if (comments.length > 0) {
                        if (key === 'j') {
                            currentCommentIndex = (currentCommentIndex + 1) % comments.length;
                        } else {
                            currentCommentIndex = (currentCommentIndex === -1)
                                ? comments.length - 1
                                : (currentCommentIndex - 1 + comments.length) % comments.length;
                        }
                        comments[currentCommentIndex].scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
            }
        });

        const handle = document.getElementById('chat-handle');
        const promptHandle = document.getElementById('prompt-handle');
        const sidebar = document.getElementById('chat-sidebar');
        const sendBtn = document.getElementById('chat-send-btn');
        const textarea = document.getElementById('chat-textarea');
        const messagesContainer = document.getElementById('chat-messages');
        const chatContent = document.querySelector('.chat-content');
        const promptContent = document.getElementById('prompt-content');

        let currentSidebarView = 'chat';

        function showView(view) {
            if (view === 'chat') {
                chatContent.style.display = 'flex';
                promptContent.style.display = 'none';
            } else {
                chatContent.style.display = 'none';
                promptContent.style.display = 'flex';
            }
            currentSidebarView = view;
        }

        function toggleSidebarTo(view) {
            const isOpen = sidebar.classList.contains('open');
            if (isOpen && currentSidebarView === view) {
                sidebar.classList.remove('open');
                return;
            }
            if (!isOpen) {
                sidebar.classList.add('open');
            }
            showView(view);
        }

        handle.addEventListener('click', () => toggleSidebarTo('chat'));
        promptHandle.addEventListener('click', () => toggleSidebarTo('prompt'));

        sendBtn.addEventListener('click', sendMessage);
        textarea.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        let conversationHistory = [];

        async function sendMessage() {
            const userInput = textarea.value.trim();
            if (userInput === '') return;

            appendMessage('user', userInput);
            textarea.value = '';

            const thinkingMessage = appendMessage('assistant', 'Thinking...');

            try {
                const fullContext = `
                    You are a helpful AI assistant integrated into a code review report.
                    The user is asking for more information about the review, the code, or the PR.

                    Here is the original PR Body:
                    ---
                    ${PR_BODY}
                    ---

                    Here is the full diff of the changes:
                    ---
                    ${RAW_DIFF}
                    ---

                    Here are the initial review comments you provided:
                    ---
                    map[20:[\u007b\u007bsrc\/utils\/calculator.test.ts 20 Using a controllable promise pattern for async tests is a great approach. It allows for precise control over when the promise resolves, making tests more deterministic and easier to debug. LOW\u007d 1 7 []\u007d] 35:[\u007b\u007bsrc\/utils\/calculator.test.ts 35 Good test coverage for basic arithmetic operations. Consider adding edge cases like very large numbers or floating point precision tests. MEDIUM\u007d 2 7 []\u007d] 50:[\u007b\u007bsrc\/utils\/calculator.test.ts 50 The division by zero test is important. Make sure the error message is user-friendly and consider logging the error for debugging purposes. MEDIUM\u007d 3 7 []\u007d] 55:[\u007b\u007bsrc\/utils\/calculator.test.ts 55 This async test pattern using controllable promises is excellent for testing race conditions and timeout scenarios. Well implemented! LOW\u007d 4 7 []\u007d] 70:[\u007b\u007bsrc\/utils\/calculator.test.ts 70 The history tracking feature is a nice addition. However, I notice the history array could grow unbounded. Consider adding a maximum history size or a method to clear old entries.\n\n\u0060\u0060\u0060suggestion\n    \/\/ Consider adding a maxHistory parameter to prevent memory issues\n    const MAX_HISTORY = 100;\n    if (this.history.length \u003e MAX_HISTORY) \u007b\n        this.history.shift();\n    \u007d\n\u0060\u0060\u0060 CRITICAL\u007d 5 7 []\u007d]]
                    ---

                    Here is the conversation history:
                    ---
                    ${conversationHistory.map(m => `${m.role}: ${m.parts[0].text}`).join('\n')}
                    ---

                    Now, please answer the following question from the user.
                `;

                const GEMINI_API_URL = `https://generativelanguage.googleapis.com/v1beta/models/TEST_MODEL_NAME_PLACEHOLDER:streamGenerateContent?key=${GEMINI_API_KEY}`;

                conversationHistory.push({ role: 'user', parts: [{ text: userInput }] });

                const requestBody = {
                    contents: [
                        ...conversationHistory,
                         { role: 'model', parts: [{ text: fullContext }] }
                    ],
                };

                const response = await fetch(GEMINI_API_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(requestBody),
                });

                if (!response.ok) {
                    throw new Error(`API request failed: ${response.statusText}`);
                }

                thinkingMessage.remove();
                const assistantMessage = appendMessage('assistant', '');
                const assistantTextElement = assistantMessage.querySelector('p');

                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                let assistantResponse = '';

                while (true) {
                    const { value, done } = await reader.read();
                    if (done) {
                        break;
                    }

                    const chunk = decoder.decode(value, { stream: true });
                    buffer += chunk;

                    let startIndex = 0;
                    while (startIndex < buffer.length) {
                        let objectStart = buffer.indexOf('{', startIndex);
                        if (objectStart === -1) break;

                        let braceCount = 0;
                        let objectEnd = -1;

                        for (let i = objectStart; i < buffer.length; i++) {
                            if (buffer[i] === '{') {
                                braceCount++;
                            } else if (buffer[i] === '}') {
                                braceCount--;
                                if (braceCount === 0) {
                                    objectEnd = i;
                                    break;
                                }
                            }
                        }

                        if (objectEnd === -1) {
                            break;
                        }

                        const jsonStr = buffer.substring(objectStart, objectEnd + 1);

                        try {
                            const chunk = JSON.parse(jsonStr);

                            if (chunk.candidates && chunk.candidates[0] && chunk.candidates[0].content && chunk.candidates[0].content.parts) {
                                const text = chunk.candidates[0].content.parts[0].text;
                                if (text) {
                                    assistantResponse += text;
                                    assistantTextElement.textContent = assistantResponse;
                                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                                }
                            }
                        } catch (e) {
                        }

                        startIndex = objectEnd + 1;
                    }

                    if (startIndex > 0) {
                        buffer = buffer.substring(startIndex);
                    }
                }

                conversationHistory.push({ role: 'model', parts: [{ text: assistantResponse }] });

            } catch (error) {
                thinkingMessage.remove();
                appendMessage('assistant', 'Sorry, I encountered an error. Please check the console for details.');
            }
        }

        function appendMessage(role, text) {
            const messageDiv = document.createElement('div');
            messageDiv.classList.add('message', role);

            const p = document.createElement('p');
            p.textContent = text;
            messageDiv.appendChild(p);

            messagesContainer.appendChild(messageDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            return messageDiv;
        }
    });
    </script>
  </body>
</html>
